# =============================================================================
# Autoreels Web — Environment Variables (Plug n Play)
# =============================================================================
# Copy this file to .env and fill in the values before running the app.
#   cp .env.example .env
# =============================================================================

# --- Database (SQLite via Prisma) ---
DATABASE_URL="file:./prisma/dev.db"

# --- NextAuth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
# App URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# --- Cron (Publisher) ---
# Secret token to authenticate cron requests to /api/cron/publisher
CRON_SECRET="CHANGE_ME"

# --- Redis (Required for auto-publishing & rate limits) ---
REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:PORT"
# Or if using REST API separately (Upstash):
# REDIS_URL="https://YOUR_ENDPOINT.upstash.io"
# REDIS_TOKEN="YOUR_UPSTASH_TOKEN"

# Plug-and-Play Admin Credentials
ADMIN_EMAIL="admin@autoreels.com"
ADMIN_PASSWORD="adminpassword"

