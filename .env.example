# =============================================================================
# Autoreels Web — Environment Variables (Plug n Play)
# =============================================================================
# Copy this file to .env and fill in the values before running the app.
#   cp .env.example .env
# =============================================================================

# --- Database (SQLite via Prisma) ---
# Path inside the container; the /app/data volume persists it across deploys.
DATABASE_URL="file:/app/data/prod.db"

# --- NextAuth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
# Public URL of the app (no trailing slash) — used for callbacks/redirects.
# Must NOT be localhost in production.
NEXTAUTH_URL="https://SEU-DOMINIO"

# --- Public base URL (media URLs sent to Instagram) ---
# The cron builds absolute media URLs from this value so the Instagram Graph
# API can fetch the files. Use the same public domain as NEXTAUTH_URL.
# If unset, falls back to NEXTAUTH_URL (when not localhost).
PUBLIC_BASE_URL="https://SEU-DOMINIO"

# --- YouTube (youtube-community-api) ---
# OBRIGATÓRIAS para usar Shorts e Posts na Comunidade. Sem elas a integração
# fica desconfigurada (a Settings mostra diagnóstico por variável ausente) e o
# cron falha os posts de YouTube com erro definitivo. NÃO existe default
# localhost — dentro do container http://localhost:8000 apontaria para o
# próprio app, então a ausência é sempre reportada.
YOUTUBE_API_BASE_URL="https://yt-api.SEU-DOMINIO"
YOUTUBE_API_KEY="CHANGE_ME"

# --- Admin credentials (single-user auth, compared at login) ---
# The app authenticates against these env vars — they are NOT stored in the DB.
# ADMIN_PASSWORD must be strong (>= 12 chars) and different from the example.
ADMIN_EMAIL="CHANGE_ME"
ADMIN_PASSWORD="CHANGE_ME"

# --- Cron (Publisher) ---
# Secret token to authenticate cron requests to /api/cron/publisher
CRON_SECRET="CHANGE_ME"
GRAPH_API_VERSION="v24.0"

# --- Publisher Worker (used by the worker container) ---
# Base URL of the app service inside the Docker network.
APP_URL="http://app:3000"

# --- TikTok OAuth & Posting (Content Posting API v2 — Direct Post) ---
# Obrigatórias para conectar canais TikTok e publicar vídeos via Direct Post.
# Cadastre o callback no TikTok Developer Console (Login Kit + Content Posting API).
# Whitelist: TIKTOK_REDIRECT_URI + (opcional p/ PULL_FROM_URL) https://SEU-DOMINIO/api/file/*
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Defaults to NEXTAUTH_URL + /api/tiktok/oauth/callback when empty.
# Em produção use HTTPS: https://autoreels.cunhov.site/api/tiktok/oauth/callback
TIKTOK_REDIRECT_URI=""
# Domínio verificado no app TikTok se usar PULL_FROM_URL (opcional; FILE_UPLOAD é default).
# TIKTOK_VERIFIED_DOMAIN="autoreels.cunhov.site"

# --- Instagram OAuth (optional but recommended for creating Channels) ---
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
# Defaults to NEXTAUTH_URL + /api/channels/oauth/callback when empty
INSTAGRAM_REDIRECT_URI=""
# Optional client-side fallback (only needed if the frontend uses it)
NEXT_PUBLIC_INSTAGRAM_CLIENT_ID=""

# --- Redis (legacy optional token source for existing Channels) ---
# Only needed if you have Channels whose access token is stored in Redis
# under a "token_..." key. Safe to leave commented out otherwise.
# REDIS_URL="rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:PORT"
# REDIS_TOKEN="YOUR_UPSTASH_TOKEN"

# --- IA via OpenRouter (F5 — título + produtos YT pela descrição) ---
# Opcional: sem estas variáveis o botão "✨ Gerar título + produtos pela
# descrição" do wizard YT Short responde erro claro apontando para esta
# configuração. Gere a chave em https://openrouter.ai/keys (basta conta + $1-5
# de crédito). A chave vive no servidor e NUNCA é exposta ao frontend.
OPENROUTER_API_KEY=""
# Modelo compatível OpenAI. Default barato e estável; qualquer modelo da lista
# https://openrouter.ai/models aceito (ex.: "openai/gpt-4o-mini",
# "mistralai/ministral-8b", "google/gemini-flash-1.5").
OPENROUTER_MODEL="openai/gpt-4o-mini"
