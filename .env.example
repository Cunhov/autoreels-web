# =============================================================================
# Autoreels Web — Environment Variables (Plug n Play)
# =============================================================================
# Copy this file to .env and fill in the values before running the app.
#   cp .env.example .env
# =============================================================================

# --- Database (SQLite via Prisma) ---
DATABASE_URL="file:./prisma/dev.db"

# --- NextAuth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
# App URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# --- Cron (Publisher) ---
# Secret token to authenticate cron requests to /api/cron/publisher
CRON_SECRET="CHANGE_ME"

# --- Optional: Redis (for rate-limiting / lock) ---
# REDIS_URL="https://YOUR_REDIS.upstash.io"
# REDIS_TOKEN=""
