      "parameters": {
        "jsCode": "const substances = [\n  {\n    \"keyword\": \"creatina\",\n    \"name\": \"Creatina Monohidratada\",\n    \"keywords\": [\n      \"creatina\",\n      \"creatine\"\n    ],\n    \"description\": \"A Creatina é um composto de aminoácidos armazenado nos músculos como fosfocreatina.\",\n    \"action\": \"Aumenta a produção de ATP, melhorando força, potência e volume muscular.\",\n    \"dosage\": \"Tomar 3g a 5g por dia, todos os dias.\",\n    \"duration\": \"Uso contínuo, sem necessidade de pausas.\"\n  },\n  {\n    \"keyword\": \"cafeina\",\n    \"name\": \"Cafeína Anidra\",\n    \"keywords\": [\n      \"cafeina\",\n      \"cafeína\",\n      \"caffeine\"\n    ],\n    \"description\": \"A Cafeína é um alcaloide estimulante do sistema nervoso central.\",\n    \"action\": \"Reduz a percepção de fadiga, aumenta o foco e melhora o desempenho físico.\",\n    \"dosage\": \"Tomar 100mg a 300mg por dia, evitando após as 18h.\",\n    \"duration\": \"Uso pontual ou em ciclos de 4 a 8 semanas.\"\n  }\n];\n\nfunction normalizeText(text) {\n  if (!text) return '';\n  return text\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .replace(/[^a-z0-9]/g, \"\");\n}\n\nfunction normalizeForWordBoundary(text) {\n  if (!text) return '';\n  return text\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\");\n}\n\nfor (const item of $input.all()) {\n  const comment = item.json.mensagem || '';\n  const dm = item.json.direct_message || '';\n  const textToCheck = (comment + ' ' + dm).trim();\n  let matchedSubstance = null;\n  if (textToCheck) {\n    const normalizedText = normalizeText(textToCheck);\n    const normalizedForBoundary = normalizeForWordBoundary(textToCheck);\n    for (const sub of substances) {\n      let isMatch = false;\n      for (const kw of sub.keywords) {\n        const normalizedKw = normalizeText(kw);\n        if (normalizedKw.length >= 4) {\n          if (normalizedText.includes(normalizedKw)) {\n            isMatch = true;\n            break;\n          }\n        } else if (normalizedKw.length > 0) {\n          const regex = new RegExp('\\\\b' + normalizedKw + '\\\\b', 'i');\n          if (regex.test(normalizedForWordBoundary)) {\n            isMatch = true;\n            break;\n          }\n        }\n      }\n      if (isMatch) {\n        matchedSubstance = {\n          nome: sub.name,\n          url: \"https://url.cunhov.site/\" + sub.keyword,\n          descricao: sub.description,\n          acao: sub.action,\n          dosagem: sub.dosage,\n          duracao: sub.duration\n        };\n        break;\n      }\n    }\n  }\n  item.json.substancia = matchedSubstance;\n}\n\nreturn $input.all();"
      },
