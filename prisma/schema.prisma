generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


// NextAuth Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  
  // App Relations
  channels      Channel[]
  planners      Planner[]
  posts         Post[]
  contentItems  ContentItem[]

  // Instagram Automation (módulo Automações)
  igAutomations      IgAutomation[]
  igContacts         IgContact[]
  igEvents           IgEvent[]
  igActionLogs       IgActionLog[]
  igSequences        IgSequence[]
  igClicks           IgClick[]
  igOutboundWebhooks IgOutboundWebhook[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
model AppConfig {
  key   String  @id
  value String?

  @@map("app_config")
}

model Channel {
  id                  String   @id @default(uuid())
  user_id             String
  name                String
  platform            String
  access_token        String?
  token_source        String?  @default("manual")
  token_expires_at    DateTime?
  token_refreshed_at  DateTime?
  account_id          String?
  username            String?
  profile_picture_url String?
  status              String   @default("active")
  settings            String?  // JSON: per-channel settings (e.g. max_posts_per_hour)
  proxy_url           String?  // HTTP/HTTPS proxy por canal (http://user:pass@host:porta)
  proxy_enabled       Boolean? @default(true)
  created_at          DateTime @default(now())

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  posts    Post[]
  planners Planner[] @relation("ChannelToPlanner")

  // Instagram Automation (módulo Automações)
  igAutomations         IgAutomation[]
  igContacts            IgContact[]
  igEvents              IgEvent[]
  igActionLogs          IgActionLog[]
  igSequences           IgSequence[]
  igSequenceEnrollments IgSequenceEnrollment[]
  igClicks              IgClick[]
  igChannelState        IgChannelState?

  @@map("channels")
  @@index([user_id, status])
  @@index([platform, status])
  @@unique([user_id, account_id])
}


model Planner {
  id          String   @id @default(uuid())
  user_id     String
  name        String
  config      String   // JSON stringified
  state       String?  // JSON stringified publish state (published_indexes, last_index, template_index)
  status      String   @default("active")
  last_run    DateTime?
  created_at  DateTime @default(now())

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  logs        PlannerLog[]
  posts       Post[]
  channels    Channel[]    @relation("ChannelToPlanner")

  @@map("planners")
  @@index([user_id, status])
  @@index([user_id, created_at])
  @@index([status])
}

model PlannerLog {
  id          String   @id @default(uuid())
  planner_id  String
  level       String   @default("info")
  message     String
  details     String?  // JSON stringified
  created_at  DateTime @default(now())

  planner     Planner  @relation(fields: [planner_id], references: [id], onDelete: Cascade)

  @@map("planner_logs")
  @@index([planner_id, created_at])
  @@index([created_at])
}

model ContentItem {
  id          String   @id @default(uuid())
  user_id     String
  parent_id   String?
  type        String
  url         String?  // Can be null for folders
  thumbnail_url String?
  path        String?
  name        String?
  title       String?
  tags        String?  // JSON: array of tag strings
  size        Int?
  duration    Float?
  caption     String?
  caption_youtube String?  // caption específica do YouTube (arquivo youtube.txt na pasta)
  caption_instagram String? // caption específica do Instagram (arquivo instagram.txt na pasta)
  caption_tiktok String?  // caption específica do TikTok (arquivo tiktok.txt na pasta)
  youtube_products String?  // CSV de NOMES de produtos afiliados do YouTube (por vídeo; vence o fixo do planner)
  first_comment  String?  // primeiro comentário do vídeo (F4): YouTube publica automaticamente após o Short; IG/TikTok só salvam o texto (sem API oficial de comentário)
  created_at  DateTime @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent      ContentItem?  @relation("ParentChild", fields: [parent_id], references: [id], onDelete: Cascade)
  children    ContentItem[] @relation("ParentChild")

  @@map("content_items")
  @@index([parent_id])
  @@index([user_id, parent_id, name])
  @@index([user_id, parent_id, created_at])
  @@index([user_id, type])
}

model Post {
  id                     String    @id @default(uuid())
  user_id                String
  channel_id             String?
  planner_id             String?
  video_url              String?
  image_url              String?
  thumbnail_url          String?
  caption                String?
  media_type             String?   // REELS, IMAGE, CAROUSEL, STORIES, VIDEO
  children_urls          String?   // JSON: array of {url, type} for carousels
  share_to_feed          Boolean?  @default(true)
  location_id            String?
  collaborators          String?   // JSON or comma-separated list of collaborators
  audio_configuration    String?   // JSON object for Reels audio
  user_tags              String?   // JSON or comma-separated list of tagged users
  status                 String    @default("pending")
  scheduled_at           DateTime?
  published_at           DateTime?
  error_message          String?
  failed_reason          String?
  instagram_media_id     String?
  instagram_container_id String?
  instagram_child_ids    String?   // JSON: array of child container IDs
  attempts               Int       @default(0)   // publish attempts (retry/backoff)
  last_attempt_at        DateTime? // last time the cron tried to process this post
  container_created_at   DateTime? // when the IG container was created (3-min heuristic)
  // YouTube
  youtube_type           String?   // "short" | "community"
  youtube_video_id       String?   // video id do Short publicado
  youtube_post_id        String?   // remote_post_id do post da Comunidade (p/ exclusão)
  youtube_options        String?   // JSON: opções do Short (title, description, privacy, made_for_kids, monetize_with_ads, category_id, pinned_comment_text)
  first_comment          String?   // snapshot do ContentItem.first_comment na criação do post (F4; consumido somente no lane YouTube)
  // TikTok
  tiktok_type            String?   // "video" (v1 apenas vídeo)
  tiktok_post_id         String?   // publish_id / video_id do TikTok
  tiktok_publish_id      String?   // publish_id returned by POST /v2/post/publish/video/init/
  tiktok_options         String?   // JSON: opções do TikTok (title, privacy_level, disable_duet, disable_stitch, disable_comment, video_cover_timestamp_ms, brand_content_toggle, brand_organic_toggle)
  tiktok_status          String?   // status TikTok: pending | processing | published | failed
  created_at             DateTime  @default(now())

  user    User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  channel Channel?  @relation(fields: [channel_id], references: [id], onDelete: SetNull)
  planner Planner?  @relation(fields: [planner_id], references: [id], onDelete: SetNull)

  @@map("posts")
  @@index([user_id, status])
  @@index([user_id, scheduled_at])
  @@index([user_id, created_at])
  @@index([status, scheduled_at])
  @@index([channel_id])
  @@index([planner_id])
  @@index([status, created_at])
  @@index([planner_id, status])
  @@index([channel_id, status, published_at])
  @@index([youtube_video_id])
  @@index([tiktok_post_id])
}

// Registro de qual usuário do app criou cada sessão remota na API do
// YouTube (POST /api/session via /api/youtube/connect ou vinculação via
// /api/youtube/sessions/link). Impede que sessões "órfãs" (canal local
// excluído sem excluir a sessão remota, ou falha pós-createSession) apareçam
// na aba "Importar sessão" de outros usuários ou sejam vinculadas por eles.
model YoutubeSession {
  remote_id          String   @id
  created_by_user_id String
  created_at         DateTime @default(now())

  @@map("youtube_sessions")
}


// Distributed lock for multi-pod publisher (BK-01). Uses DB row as mutex.
model CronLock {
  key        String   @id
  locked_at  DateTime @default(now())
  expires_at DateTime
  owner      String?

  @@map("cron_locks")
}

model PostMetric {
  id          String   @id @default(uuid())
  post_id     String   @unique
  channel_id  String?
  likes       Int      @default(0)
  comments    Int      @default(0)
  plays       Int      @default(0)
  reach       Int      @default(0)
  impressions Int      @default(0)
  saved       Int      @default(0)
  shares      Int      @default(0)
  fetched_at  DateTime @default(now())

  @@map("post_metrics")
  @@index([channel_id, fetched_at])
}

// ═══════════════════════════════════════════════════════════════════════════
// Instagram Automation — módulo "Automações" (comments + DMs + sequências)
// ═══════════════════════════════════════════════════════════════════════════

model IgAutomation {
  id                    String   @id @default(uuid())
  user_id               String
  channel_id            String
  name                  String
  enabled               Boolean  @default(true)
  priority              Int      @default(0)
  trigger               String   @default("comment") // comment | dm | story_reply | story_mention | postback
  keywords              String   // JSON string[]
  match_mode            String   @default("any") // any | all
  match_type            String   @default("contains") // contains | exact | starts_with | regex
  negative_keywords     String?  // JSON string[]
  media_ids             String?  // JSON string[] — vazio/null = qualquer post
  first_interaction_only Boolean @default(false)
  cooldown_hours        Int?
  daily_limit           Int?
  quiet_hours           String?  // JSON {start:"23:00",end:"07:00",tz:"America/Bahia"}
  settings              String?  // JSON livre (ex.: fallback IA)
  stats_sent            Int      @default(0)
  stats_matched         Int      @default(0)
  stats_failed          Int      @default(0)
  stats_clicks          Int      @default(0)
  last_run_at           DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user      User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  channel   Channel             @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  actions   IgAutomationAction[]
  events    IgEvent[]
  logs      IgActionLog[]
  clicks    IgClick[]

  @@map("ig_automations")
  @@index([user_id, channel_id])
  @@index([channel_id, enabled, priority])
}

model IgAutomationAction {
  id            String   @id @default(uuid())
  automation_id String
  position      Int      @default(0)
  type          String   // public_comment_reply | private_reply | dm_text | dm_buttons | dm_quick_replies | dm_media | ai_reply | assign_tag | start_sequence | outbound_webhook
  delay_seconds Int      @default(0)
  text_variants String?  // JSON string[] (rotação)
  buttons       String?  // JSON [{type:"web_url"|"postback", title, url?, payload?}]
  quick_replies String?  // JSON [{title,payload}]
  media_url     String?
  tag           String?
  sequence_id   String?
  webhook_id    String?
  ai_prompt     String?
  config        String?  // JSON extra (ex.: {"trackClicks":true})
  created_at    DateTime @default(now())

  automation IgAutomation @relation(fields: [automation_id], references: [id], onDelete: Cascade)

  @@map("ig_automation_actions")
  @@index([automation_id, position])
}

model IgSubstance {
  id          String   @id @default(uuid())
  user_id     String?
  keyword     String   @unique
  name        String
  keywords    String   // JSON string[] sinônimos
  description String
  action      String
  dosage      String
  duration    String
  url         String?
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now())

  @@map("ig_substances")
}

model IgContact {
  id                 String    @id @default(uuid())
  user_id            String
  channel_id         String
  ig_user_id         String
  username           String?
  name               String?
  profile_picture    String?
  tags               String?   // JSON string[]
  notes              String?
  custom_fields      String?   // JSON object
  bot_paused_until   DateTime?
  last_message_at    DateTime?
  last_comment_at    DateTime?
  interactions_count Int       @default(0)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  channel     Channel     @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  events      IgEvent[]
  logs        IgActionLog[]
  enrollments IgSequenceEnrollment[]

  @@map("ig_contacts")
  @@unique([channel_id, ig_user_id])
  @@index([user_id, channel_id])
  @@index([username])
}

model IgEvent {
  id            String   @id @default(uuid())
  user_id       String
  channel_id    String
  automation_id String?
  contact_id    String?
  direction     String   @default("in") // in | out
  kind          String   // comment | dm | story_reply | story_mention | postback | reaction | echo | system
  dedupe_key    String   @unique // comment:<id> | message:<mid> | postback:<mid> | reaction:<mid> | action:<uuid>
  ig_event_id   String?
  media_id      String?
  text          String?
  username      String?
  from_ig_id    String?
  payload       String?  // JSON cru
  status        String   @default("received") // received | matched | sent | failed | skipped | paused | duplicate
  error         String?
  created_at    DateTime @default(now())

  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  channel    Channel       @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  automation IgAutomation? @relation(fields: [automation_id], references: [id], onDelete: SetNull)
  contact    IgContact?    @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@map("ig_events")
  @@index([channel_id, created_at])
  @@index([automation_id, created_at])
  @@index([contact_id, created_at])
  @@index([user_id, direction, created_at])
}

model IgActionLog {
  id            String   @id @default(uuid())
  user_id       String
  channel_id    String
  automation_id String?
  contact_id    String?
  event_id      String?
  action_type   String
  status        String   // pending | sent | failed | skipped
  request       String?  // JSON
  response      String?  // JSON resumido
  error         String?
  created_at    DateTime @default(now())

  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  channel    Channel       @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  automation IgAutomation? @relation(fields: [automation_id], references: [id], onDelete: SetNull)
  contact    IgContact?    @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@map("ig_action_logs")
  @@index([channel_id, created_at])
  @@index([automation_id, created_at])
}

model IgJob {
  id           String    @id @default(uuid())
  user_id      String
  channel_id   String?
  type         String // action | sequence_step | ai_reply | outbound_webhook
  run_at       DateTime
  payload      String    // JSON
  status       String    @default("pending") // pending | running | done | failed | cancelled
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  locked_at    DateTime?
  last_error   String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("ig_jobs")
  @@index([status, run_at])
  @@index([channel_id])
}

model IgSequence {
  id         String   @id @default(uuid())
  user_id    String
  channel_id String
  name       String
  enabled    Boolean  @default(true)
  steps      String   // JSON [{delay_seconds,type,text_variants,buttons,quick_replies,media_url,ai_prompt,config}]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user        User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  channel     Channel                @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  enrollments IgSequenceEnrollment[]

  @@map("ig_sequences")
  @@index([user_id, channel_id])
}

model IgSequenceEnrollment {
  id           String    @id @default(uuid())
  sequence_id  String
  contact_id   String
  channel_id   String
  current_step Int       @default(0)
  status       String    @default("active") // active | done | cancelled
  attempts     Int       @default(0) // erros consecutivos do passo atual (máx 3 → cancelled)
  next_run_at  DateTime?
  started_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  sequence IgSequence @relation(fields: [sequence_id], references: [id], onDelete: Cascade)
  contact  IgContact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  channel  Channel    @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@map("ig_sequence_enrollments")
  @@unique([sequence_id, contact_id])
  @@index([status, next_run_at])
}

model IgChannelState {
  channel_id        String    @id
  subscribed_fields String?   // JSON string[]
  last_checked_at   DateTime?
  last_event_at     DateTime?
  status            String    @default("unknown") // ok | missing | partial | token_invalid | error | unknown
  last_error        String?
  updated_at        DateTime  @updatedAt

  channel Channel @relation(fields: [channel_id], references: [id], onDelete: Cascade)

  @@map("ig_channel_state")
}

model IgClick {
  id            String    @id @default(uuid())
  user_id       String
  channel_id    String?
  automation_id String?
  contact_id    String?
  slug          String    @unique
  target_url    String
  utm_source    String?
  utm_medium    String?
  utm_campaign  String?
  clicks        Int       @default(0)
  created_at    DateTime  @default(now())
  last_click_at DateTime?

  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  channel    Channel?      @relation(fields: [channel_id], references: [id], onDelete: SetNull)
  automation IgAutomation? @relation(fields: [automation_id], references: [id], onDelete: SetNull)

  @@map("ig_clicks")
  @@index([automation_id, created_at])
}

model IgOutboundWebhook {
  id         String   @id @default(uuid())
  user_id    String
  channel_id String?
  name       String
  url        String
  secret     String?
  events     String   // JSON string[]: comment.matched | dm.matched | action.sent | action.failed | click | sequence.step
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("ig_outbound_webhooks")
  @@index([user_id])
}
